# Copier ce fichier en .env pour le développement local
DATABASE_URL=postgres://habit:habit@localhost:5433/habit_tracker
# Une longue chaîne aléatoire : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-moi
# Comptes administrateurs (page /admin.html), séparés par des virgules
# ADMIN_USERNAMES=ton_nom   (vide = le premier compte créé est admin)
# Code à taper après le bouton « Admin » pour devenir admin (jamais dans le code source)
# ADMIN_CODE=12345
